              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Retorna status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Retorna a unidade de demonstração\", function () {\r\n    const resposta = pm.response.json();\r\n    const unidade = resposta.content.find(\r\n        item => item.codigoPublico === \"RECIFE-CENTRO\"\r\n    );\r\n\r\n    pm.expect(unidade).to.exist;\r\n    pm.collectionVariables.set(\"idUnidade\", unidade.idUnidade);\r\n});"
