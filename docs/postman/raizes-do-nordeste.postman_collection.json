    {
      "name": "Login - campos obrigatórios vazios",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Retorna status 422\", function () {\r\n    pm.response.to.have.status(422);\r\n});\r\n\r\npm.test(\"Retorna erro padronizado de validação\", function () {\r\n    const resposta = pm.response.json();\r\n\r\n    pm.expect(resposta.code).to.eql(\"VALIDATION_ERROR\");\r\n    pm.expect(resposta.message).to.eql(\"Existem campos inválidos.\");\r\n    pm.expect(resposta.path).to.eql(\"/api/v1/auth/login\");\r\n    pm.expect(resposta.details).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Informa os dois campos obrigatórios\", function () {\r\n    const resposta = pm.response.json();\r\n    const campos = resposta.details.map(detalhe => detalhe.field);\r\n\r\n    pm.expect(campos).to.include(\"email\");\r\n    pm.expect(campos).to.include(\"senha\");\r\n});"
            ]
          }
        }
