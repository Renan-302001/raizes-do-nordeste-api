    {
      "name": "Login - Sucesso",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Retorna status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Retorna um token Bearer\", function () {\r\n    const resposta = pm.response.json();\r\n\r\n    pm.expect(resposta.accessToken).to.be.a(\"string\").and.not.empty;\r\n    pm.expect(resposta.tokenType).to.eql(\"Bearer\");\r\n    pm.expect(resposta.expiresIn).to.eql(900);\r\n});\r\n\r\npm.test(\"Não expõe dados sensíveis\", function () {\r\n    const resposta = pm.response.json();\r\n\r\n    pm.expect(resposta).not.to.have.property(\"senha\");\r\n    pm.expect(resposta).not.to.have.property(\"senhaHash\");\r\n});\r\n\r\nconst resposta = pm.response.json();\r\npm.collectionVariables.set(\"accessToken\", resposta.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"cadastro.dia13@example.com\",\r\n  \"senha\": \"SenhaDeTesteDia13!\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
