    {
      "name": "Login - Senha incorreta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Retorna status 401\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.test(\"Retorna erro padronizado de credenciais\", function () {\r\n    const resposta = pm.response.json();\r\n\r\n    pm.expect(resposta.code).to.eql(\"CREDENCIAIS_INVALIDAS\");\r\n    pm.expect(resposta.message).to.eql(\"E-mail ou senha inválidos.\");\r\n    pm.expect(resposta.path).to.eql(\"/api/v1/auth/login\");\r\n    pm.expect(resposta.details).to.be.an(\"array\").that.is.empty;\r\n});\r\n\r\npm.test(\"Não informa qual credencial está incorreta\", function () {\r\n    const resposta = pm.response.json();\r\n\r\n    pm.expect(resposta.message).not.to.include(\"cadastrado\");\r\n    pm.expect(resposta.message).not.to.include(\"incorreta\");\r\n});"
            ]
          }
        }
